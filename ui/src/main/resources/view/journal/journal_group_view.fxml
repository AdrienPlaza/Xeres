<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import io.xeres.ui.custom.ImageSelectorView?>
<VBox spacing="8" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="io.xeres.ui.controller.journal.JournalGroupWindowController">
    <VBox.margin>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
    </VBox.margin>
    <Label text="%journal.group.name"/>
    <TextField fx:id="name"/>
    <Label text="%journal.group.description"/>
    <TextField fx:id="description"/>
    <ImageSelectorView fx:id="postLogo" maxHeight="120" maxWidth="120"/>
    <Button fx:id="send" mnemonicParsing="false" text="%journal.group.create" maxWidth="Infinity"/>
</VBox>
