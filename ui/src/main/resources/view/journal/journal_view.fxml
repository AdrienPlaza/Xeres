<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox alignment="TOP_LEFT" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="io.xeres.ui.controller.journal.JournalViewController" spacing="6">
    <HBox alignment="CENTER_LEFT" spacing="6">
        <HBox.margin>
            <Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/>
        </HBox.margin>
        <Button fx:id="createJournal" mnemonicParsing="false" text="%journal.view.create-journal">
            <graphic>
                <FontIcon iconLiteral="mdi2f-folder-plus"/>
            </graphic>
        </Button>
        <Button fx:id="newArticle" mnemonicParsing="false" text="%journal.view.new-article">
            <graphic>
                <FontIcon iconLiteral="mdi2p-pencil-plus"/>
            </graphic>
        </Button>
    </HBox>
    <HBox VBox.vgrow="ALWAYS" spacing="6">
        <VBox spacing="4" prefWidth="180" minWidth="160">
            <TextField fx:id="searchField" promptText="%journal.view.search"/>
            <ToggleButton fx:id="filterAll" mnemonicParsing="false" text="%journal.view.filter.all" maxWidth="Infinity"/>
            <ToggleButton fx:id="filterLiked" mnemonicParsing="false" text="%journal.view.filter.liked" maxWidth="Infinity"/>
            <ToggleButton fx:id="filterFavorited" mnemonicParsing="false" text="%journal.view.filter.favorited" maxWidth="Infinity"/>
            <ToggleButton fx:id="filterCommented" mnemonicParsing="false" text="%journal.view.filter.commented" maxWidth="Infinity"/>
        </VBox>
        <StackPane HBox.hgrow="ALWAYS">
            <ListView fx:id="articleList" VBox.vgrow="ALWAYS"/>
            <VBox fx:id="emptyView" alignment="CENTER" spacing="8" visible="false" managed="false">
                <Label text="%journal.view.empty" styleClass="text-caption"/>
            </VBox>
        </StackPane>
    </HBox>
</VBox>
